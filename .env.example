# ===== NexusMind 环境变量模板 =====
# 使用方法：复制本文件为 .env，再填入真实值。.env 已被 .gitignore 忽略，请勿提交。
#   Windows:  Copy-Item .env.example .env
#   Linux/macOS:  cp .env.example .env

# ===== 大模型配置 =====
# DashScope API Key（必填，从阿里云百炼/灵积平台获取）
DASHSCOPE_API_KEY=
# API 基础地址（DashScope 兼容 OpenAI 格式）
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Agent 主模型（推荐 qwen-plus，平衡性能与成本）
AGENT_BASE_MODEL=qwen-plus
# 记忆提取模型（后台任务使用，建议用小模型节省成本）
SUMMARIZATION_MODEL=qwen-turbo

# ===== 嵌入模型配置 =====
# Embedding Provider: siliconflow | dashscope | ollama | openai_compatible
EMBEDDING_PROVIDER=siliconflow
# 文本向量化模型（用于知识库和记忆的语义检索）
EMBEDDING_MODEL=BAAI/bge-m3
# Embedding API Key（SiliconFlow: https://siliconflow.cn 获取；ollama 留空）
EMBEDDING_API_KEY=
# Embedding 服务地址（留空使用 provider 默认值）
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=10
# 向量维度（bge-m3 / text-embedding-v4 均为 1024 维）
dense_dimension=1024

# ===== Rerank 重排序配置 =====
# Rerank Provider: dashscope | siliconflow
RERANK_PROVIDER=siliconflow
# 重排序模型（用于优化检索结果的相关性排序）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Rerank API Key（留空回退到 EMBEDDING_API_KEY / DASHSCOPE_API_KEY）
RERANK_API_KEY=
# 重排序 API 地址
RERANK_URL=https://api.siliconflow.cn/v1/rerank

# ===== Milvus 向量数据库配置 =====
# Zilliz Cloud 服务地址（或自建 Milvus 地址）
Milvus_url=http://localhost:19530
# 认证 Token（Zilliz Cloud 格式：username:password）
Token=
# 知识库集合名称
knowledge_base_collection=knowledge_base_collection
# 记忆集合名称
memory_collection=memory_collection
MEMORY_MIN_RELEVANCE=0.35
MEMORY_EXTRACT_TOKEN_THRESHOLD=1000
MEMORY_EXTRACT_IDLE_SECONDS=900

# ===== PostgreSQL 数据库配置 =====
# Compose 使用这些凭据；已有数据库不能只改配置来轮换密码。
POSTGRES_USER=nexusmind
POSTGRES_PASSWORD=change-me
# 完整连接字符串（包含用户名、密码、主机、端口、数据库名）
DATABASE_URL=postgresql://nexusmind:change-me@localhost:5432/echomind_db?sslmode=disable
# Harness 的版本化数据集、实验、分数、门禁和审计记录。生产环境使用 PostgreSQL。
HARNESS_DATABASE_URL=postgresql+psycopg://nexusmind:change-me@localhost:5432/echomind_db
# 分项配置（用于程序自动创建数据库）
user=nexusmind
password=change-me
host=localhost
port=5432
db_name=echomind_db

# ===== Redis 配置 =====
# Redis 连接地址（用于对话检查点存储和用户画像缓存）
REDIS_URL=redis://localhost:6379/0

# ===== 临时文件目录 =====
# 文档上传后的临时存储路径
TEMP_DIR=./tmp

# ===== 多 Agent 编排配置 =====
# 编排器最大重试次数（reflection 失败后重试上限）
ORCHESTRATOR_MAX_RETRIES=2

# ===== MCP 工具协议配置 =====
# MCP 服务端监听端口（内部 JSON-RPC 2.0 通信）
MCP_SERVER_PORT=8765
# MCP 调用超时（秒）
MCP_CALL_TIMEOUT=30

# ===== Monitor 闭环监控配置 =====
MONITOR_WINDOW_SIZE=1000
MONITOR_WINDOW_SECONDS=300
MONITOR_SUCCESS_RATE_THRESHOLD=0.95
MONITOR_P99_THRESHOLD_MS=3000
MONITOR_P99_CRITICAL_MS=5000

# ===== LLM-as-Judge 评测配置 =====
EVALUATION_PASS_THRESHOLD=6.0
EVALUATION_MAX_BAD_CASES=1000
EVALUATION_MODEL=qwen-turbo

# 改写时参考的最大历史轮数
QUERY_REWRITE_MAX_HISTORY=6
# 审计日志最大保留条数
ACL_MAX_AUDIT_LOGS=5000

NEXUSMIND_ALLOW_HEADER_IDENTITY=true
# 允许跨域访问 API 的前端源，以逗号分隔；部署时替换为实际前端域名
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Skills / 进化配置 =====
SKILLS_DIR=./skills
EVOLUTION_DIR=./evolution

# ===== 会话恢复配置 =====
SESSION_MAX_TOKENS=8000
SESSION_COMPRESS_THRESHOLD=6000
SESSION_TTL_SECONDS=86400
SESSION_PERSISTENCE_REQUIRED=true
# 同时支持会话历史持久化和图执行恢复。开启后必须配置下方密钥。
GRAPH_CHECKPOINT_ENABLED=true
# PostgreSQL LangGraph Checkpointer 的加密密钥。必须使用 Fernet 密钥。
# 生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GRAPH_CHECKPOINT_FERNET_KEY=
GRAPH_CHECKPOINT_IDENTITY_KEY=
GRAPH_CHECKPOINT_PREVIOUS_KEYS=
NEXUSMIND_ENV=development
NEXUSMIND_SCHEMA_BOOTSTRAP=false
INDEX_ADOPT_LEGACY=false
UPLOAD_WORKER_MODE=embedded
UPLOAD_STORAGE_ROOT=./data/uploads
UPLOAD_COMPLETED_RETENTION_DAYS=30
UPLOAD_FAILED_RETENTION_DAYS=7
MAINTENANCE_ENABLED=true
REDIS_REQUIRED=false
GRAPH_CHECKPOINT_TTL_DAYS=30
LONG_TERM_MEMORY_INGEST_ENABLED=true
LONG_TERM_MEMORY_TTL_DAYS=0
# 原文存档加密密钥。必须使用 Fernet 密钥。
CONTEXT_STORE_FERNET_KEY=
# 分层长期记忆。独立密钥为空时复用原文归档密钥；不要随意轮换已有密钥。
MANAGED_MEMORY_ENABLED=true
MEMORY_STORE_FERNET_KEY=
MEMORY_FILES_ROOT=./data/memory_files
MEMORY_CONSOLIDATION_INTERVAL_SECONDS=1800
# 回答合成阶段的输入估算预算，需按部署模型的真实窗口留足输出空间
SYNTHESIS_INPUT_BUDGET=16000
SYNTHESIS_CONTEXT_WINDOW_TOKENS=32768
SYNTHESIS_OUTPUT_TOKENS=8192

# ===== MCP 外部 Server 配置 =====
MCP_SERVERS=

# ===== 进化闭环 =====
EVOLUTION_LOOP_ENABLED=true
# 轮询间隔（秒），默认 300 = 5 分钟
EVOLUTION_LOOP_INTERVAL=300
# 自动接受阈值（规则置信度 >= 此值自动 accept，0 表示禁用自动接受）
EVOLUTION_AUTO_ACCEPT=0.85
EVOLUTION_BATCH_LIMIT=10

# ===== Harness 发布门禁 =====
HARNESS_MAX_QUALITY_DROP=0
HARNESS_MAX_LATENCY_RATIO=1.15
HARNESS_MAX_COST_RATIO=1.20
HARNESS_REQUIRE_USAGE_METRICS=true
HARNESS_CASE_TIMEOUT_SECONDS=180
HARNESS_CONCURRENCY=2
# true 时，工作区存在未提交修改会阻断晋升。开发环境可保持 false，CI 建议设为 true。
HARNESS_REQUIRE_CLEAN_GIT=false
HARNESS_SEED=20260923
# 安全保护集的最低通过率
HARNESS_SECURITY_PASS_RATE=1.0
LLM_INPUT_USD_PER_1K=
LLM_OUTPUT_USD_PER_1K=
LLM_PRICING_VERSION=
HARNESS_RBAC_ROLES={"system":["admin","approve","release","rollback","observe"],"evolution":["approve","observe"],"ops":["release","rollback","observe"],"runtime":["observe","rollback"],"viewer":["observe"]}
HARNESS_CANARY_MIN_QUALITY=0.8
HARNESS_CANARY_MIN_SAFETY=1.0
HARNESS_CANARY_MAX_P95_MS=5000
HARNESS_CANARY_MIN_SAMPLES=5

# ===== 可观测性 =====
# OpenTelemetry OTLP/HTTP base URL; SDK appends /v1/traces.
OTEL_SERVICE_NAME=nexusmind-agent
OTEL_COLLECTOR_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.162.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
LLM_STREAM_USAGE=true
# Metrics are disabled without a bearer token or token file.
METRICS_BEARER_TOKEN=
METRICS_BEARER_TOKEN_FILE=
OBSERVABILITY_METRICS_TOKEN_FILE=./runtime/observability-secrets/metrics-token
OBSERVABILITY_GRAFANA_PASSWORD_FILE=./runtime/observability-secrets/grafana-password

# ===== 包管理镜像（国内网络可选）=====
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
